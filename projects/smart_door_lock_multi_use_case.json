  "use_cases": [
    {
      "use_case_id": "UC-01",
      "title": "Remote unlock by homeowner",
      "description": "Lock paired and online; the homeowner is authenticated in the app with MFA. The homeowner taps Unlock, the mobile app requests the command via the cloud, the cloud backend authorises and forwards it to the lock, the lock verifies and unlocks, and an audit event is logged.",
      "system_model": "{\"trust_boundaries\": [\"phone-cloud TLS\", \"cloud-lock TLS\", \"device-hardware physical\"], \"data_flows\": [\"unlock_command\", \"audit_event_sync\"]}",
      "asset_ids": [
        "AS-1",
        "AS-2",
        "AS-4",
        "AS-6"
      ]
    },
    {
      "use_case_id": "UC-02",
      "title": "Issue a time-bound guest e-key",
      "description": "The homeowner creates a time-bound e-key for a guest in the app. The cloud backend stores the credential and its schedule, sends it to the guest's phone, and the lock receives the credential data so it can verify the guest later.",
      "system_model": "{\"trust_boundaries\": [\"phone-cloud TLS\", \"cloud-lock TLS\", \"phone-lock BLE\"], \"data_flows\": [\"e_key_sync\", \"schedule_sync\", \"audit_event_sync\"]}",
      "asset_ids": [
        "AS-2",
        "AS-4",
        "AS-5",
        "AS-6"
      ]
    },
    {
      "use_case_id": "UC-03",
      "title": "Revoke a lost or stolen e-key",
      "description": "The homeowner reports a lost phone or key. The cloud backend marks the e-key as revoked, pushes the revocation to the lock, and the lock rejects further use of that credential. The revocation is logged.",
      "system_model": "{\"trust_boundaries\": [\"phone-cloud TLS\", \"cloud-lock TLS\"], \"data_flows\": [\"e_key_sync\", \"audit_event_sync\"]}",
      "asset_ids": [
        "AS-2",
        "AS-4",
        "AS-5"
      ]
    },
    {
      "use_case_id": "UC-04",
      "title": "Over-the-air firmware update",
      "description": "The cloud backend offers a new signed firmware image. The lock downloads it over the OTA channel, verifies the signature, installs it using key material from the secure element, and reports the result. The update is logged.",
      "system_model": "{\"trust_boundaries\": [\"cloud-lock TLS\", \"phone-lock BLE\", \"device-hardware physical\"], \"data_flows\": [\"ota_update\", \"audit_event_sync\"]}",
      "asset_ids": [
        "AS-3",
        "AS-4",
        "AS-6"
      ]
    }
