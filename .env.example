# .env.example
# ==============================================================================
# TRC Engine -- Environment Variable Reference
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env -- it is git-ignored.
# NEVER put real secrets in this file -- placeholder values only.
#
# See config/settings.py for full field descriptions and validation rules.
# ==============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# OpenAI API key -- get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Filesystem path to the built FAISS index directory (Aryan's KB output)
FAISS_INDEX_PATH=kb/data/faiss_index

# Root directory containing raw + processed KB files (STRIDE/CAPEC/ATT&CK/CWE)
KB_DATA_DIR=kb/data

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Deployment environment: development | staging | production
ENVIRONMENT=development

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally to see full prompt and KB-chunk logs.
# Never use DEBUG in production -- it logs sensitive context.
LOG_LEVEL=INFO

# Max LLM retry attempts before escalating to human review.
# Must be between 1 and 3 (mirrors ValidationResult.retry_count le=3).
# Set to 1 in CI to keep test runs fast.
MAX_RETRY_COUNT=3

# Sentence-transformers model used to embed assets into FAISS query vectors.
# Must match the model used when the FAISS index was built.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Version tag of the KB snapshot -- update when kb/data/ is rebuilt.
# Logged verbatim in every run for reproducibility (build plan §2.7).
KB_SNAPSHOT_VERSION=v1.0
