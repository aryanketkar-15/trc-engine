      "damage_scenario": "Cloning, unauthorised entry",
      "dfd_context": { "interfaces": ["HTTPS", "REST", "OAuth 2.0"], "trust_zone": "external", "data_flows": ["e_key_sync"] },
      "device_config": { "auth": "JWT", "storage": "cloud_db", "token_type": "bearer" }
    },
    {
      "asset_id": "AS-3",
      "name": "Firmware Image",
