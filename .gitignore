# ── Secrets & environment ────────────────────────────────────────────────────
.env
*.env
secrets.json

# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── FAISS index files (binary, rebuilt from KB data) ─────────────────────────
kb/data/*.faiss
kb/data/*.index

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Full MITRE KB source files (fetched by kb/scripts/fetch_full_kb.py)
kb/data/full/
kb/data/standards/
demo_output/

# Knowledge-base package: large data stays out of Git (rebuild with the export steps)
kb_package/data/*.npy
kb_package/data/*.jsonl
kb_package/db/

# Runtime records and credentials
logs/
secrets/
*.json.bak
*.json.lock
